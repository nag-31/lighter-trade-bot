FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    PORTFOLIO_STORAGE_MODE=guest

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src

EXPOSE 8080

CMD ["python", "-B", "-m", "src.portfolio_app", "--host", "0.0.0.0", "--storage-mode", "guest"]
