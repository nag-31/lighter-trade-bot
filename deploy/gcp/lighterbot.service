[Unit]
Description=Lighter and Hyperliquid trade tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ADMIN
WorkingDirectory=/home/ADMIN/apps/lighter-trade-bot
EnvironmentFile=/home/ADMIN/apps/lighter-trade-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ADMIN/apps/lighter-trade-bot/.venv/bin/python -B -m src.dashboard
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
