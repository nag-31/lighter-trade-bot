[Unit]
Description=DeFi hack alert monitor and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ADMIN
WorkingDirectory=/home/ADMIN/apps/hack-alert-bot
Environment=PYTHONUNBUFFERED=1
Environment=ALERTBOT_DASHBOARD_HOST=127.0.0.1
Environment=ALERTBOT_DASHBOARD_PORT=8788
ExecStart=/home/ADMIN/apps/hack-alert-bot/.venv/bin/python -B -m alertbot --dry-run --dashboard
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
