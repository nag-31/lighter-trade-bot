[Unit]
Description=Crypto speculation alert bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ADMIN
WorkingDirectory=/home/ADMIN/apps/speculation-alert-bot
EnvironmentFile=/home/ADMIN/apps/speculation-alert-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ADMIN/apps/speculation-alert-bot/.venv/bin/python -B main.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
