[Unit]
Description=Futures PnL importer static site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ADMIN
WorkingDirectory=/home/ADMIN/apps/futures-pnl-importer
ExecStart=/usr/bin/python3 -B -m http.server 5180 --bind 127.0.0.1 --directory dist
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
